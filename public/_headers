# Cloudflare Static Assets headers. Files in /assets/ have content hashes, so
# browsers can keep them (fonts, CSS, JS) without revalidating on every reload.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Novel covers and illustrations keep their URL when replaced, so browsers
# revalidate them daily instead of keeping them forever.
/img/*
  Cache-Control: public, max-age=86400
